{
  "name": "simpleac",
  "version": "0.1.0-beta.1",
  "private": true,
  "description": "Self-hostable FiveM anti-cheat and operations platform",
  "scripts": {
    "build": "bun run build:nui && bun run build:ocr && bun run build:web && bun run build:licenses && bun run check && esbuild server/bootstrap.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/server/bootstrap.js --sourcemap && esbuild server/evidence/ocr/prepare-worker.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/server/ocr-prepare.js && esbuild server/relay/relay-worker.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/server/relay-worker.js",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p web/nui/tsconfig.json --noEmit",
    "lint": "biome lint .",
    "format": "biome format .",
    "format:write": "biome check --write .",
    "test": "vitest run",
    "test:lua": "lua tests/lua/run.lua",
    "test:watch": "vitest",
    "ci": "biome ci .",
    "build:nui": "bun scripts/build-nui.mjs",
    "build:web": "vite build --config web/nui/vite.config.ts",
    "dev:web": "vite --config web/nui/vite.config.ts",
    "build:ocr": "bun scripts/vendor-ocr.mjs",
    "build:licenses": "bun scripts/third-party-notices.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@citizenfx/http-wrapper": "^0.2.2",
    "@koa/router": "^15.7.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "jpeg-js": "^0.4.4",
    "koa": "^3.2.1",
    "lucide-react": "^1.52.0",
    "node-turn": "^0.0.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@citizenfx/three": "^0.100.0",
    "@types/koa": "^3.0.3",
    "@types/koa__router": "^12.0.5",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "esbuild": "^0.28.2",
    "javascript-obfuscator": "^5.9.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "packageManager": "bun@1.3.13"
}
