  "tour": {
    "welcome": {
      "title": "Welcome to SimpleAC",
      "text": "A short walkthrough of how to investigate a player. Everything you need to review, decide, and act is a click away."
    },
    "glance": {
      "title": "Your server at a glance",
      "text": "Players, detections, cases and evidence for the last day. Hover a chart to see the exact count for each day."
    },
    "attention": {
      "title": "Start with what needs review",
      "text": "Detections nobody has reviewed yet appear here. A detection is a signal to investigate, not proof on its own."
    },
    "players": {
      "title": "Find a player",
      "text": "See who is online, search by name, or paste any SimpleAC ID or identifier into the jump box. Open a player to see the signals behind their risk score."
    },
    "detections": {
      "title": "Review detections",
      "text": "Confirm a detection or dismiss it with a reason. Both are recorded, and the case it belongs to shows the decision."
    },
    "cases": {
      "title": "Build the case",
      "text": "A case groups signals, screenshots and notes into one investigation. Assign it, change its status, and document what you found."
    },
    "evidence": {
      "title": "Inspect supporting evidence",
      "text": "Screenshots show what the player saw, with any blacklisted text the server read from them. Every image ties back to a player and a case."
    },
    "actions": {
      "title": "Keep actions traceable",
      "text": "Every ban, kick and warning is stored with who did it and why, from automatic prevention to staff decisions."
    },
    "exceptions": {
      "title": "Allow legitimate gameplay",
      "text": "Scoped exceptions cover expected behaviour such as hospital respawns. They apply immediately and can be revoked at any time."
    },
    "profiles": {
      "title": "See your protection policy",
      "text": "The profile groups the detection rules and what the server does when one fires."
    },
    "access": {
      "title": "Control panel access",
      "text": "Grant access by identifier and choose what each person can do. A reviewer can investigate without being able to ban or change access."
    },
    "colors": {
      "title": "Make it your own",
      "text": "Change any colour with the picker, RGB sliders or a hex value. Your choice stays in this browser."
    },
    "bypass": {
      "title": "Your personal bypass",
      "text": "Bypass applies to your own player until you switch it off, so you can work without triggering your own detections."
    },
    "audit": {
      "title": "Ready to investigate",
      "text": "The audit screen makes everything reviewable. Finish to return to where you were, or replay this tour from the footer."
    }
  },
